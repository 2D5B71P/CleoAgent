{
  // Copy this file to %APPDATA%\CleoAgent\config.json and fill in your values.

  "agent": {
    // Identifier for this agent. Memory and instructions are scoped to it:
    //   %APPDATA%\CleoAgent\agents\<id>\agent.md   (persona)
    //   %APPDATA%\CleoAgent\agents\<id>\memory\    (short/long-term JSON)
    "id": "Cleo",

    // Every N user turns, distill the recent conversation into short-term
    // memories (LLM Q/A extraction). 0/1 = every turn.
    "summarizeEvery": 8
  },

  "model": {
    "provider": "open_router",
    "model": "openai/gpt-5-nano",
    // Resolve the key from the environment; do not paste the literal here.
    "api_key": "***}"
  },

  "embedding": {
    // none = offline hash fallback (deterministic, NOT semantically meaningful).
    // Set "openai" or "openrouter" + model (e.g. text-embedding-3-small) + api_key
    // for real retrieval.
    "provider": "none",
    "model": "",
    "api_key": ""
  }
}
