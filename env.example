#
# Copy this file to %APPDATA%\CleoAgent\env and fill in your values.
# The env file lives outside the repo, so it is never committed.
#
# The agent loads it into the process environment at startup. If a variable
# is already set in your shell/process environment, that value wins.
#

OPENROUTER_API_KEY=sk-or-…your-key-here
OPENROUTER_MODEL=openai/gpt-5-nano