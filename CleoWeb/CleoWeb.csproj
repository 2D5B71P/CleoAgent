<Project Sdk="Microsoft.NET.Sdk">

  <!-- CleoWeb = the web module: web_fetch / web_search tools, fetch + search
       providers and factories, SmartReader/ReverseMarkdown integration.
       Depends on CleoCore only (host kernel config types, tool contracts). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>False</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CleoCore\CleoCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ReverseMarkdown" Version="6.2.1" />
    <PackageReference Include="SmartReader" Version="0.11.1" />
  </ItemGroup>

  <!-- Web module internals stay internal; only the CLI constructs them
       (Program.cs wires up providers, factories and the web tools). -->
  <ItemGroup>
    <InternalsVisibleTo Include="CleoAgent" />
  </ItemGroup>

</Project>