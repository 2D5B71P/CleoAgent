<Project Sdk="Microsoft.NET.Sdk">

  <!-- CleoMemory = the memory module: memory_* tools, embedding providers +
       their factory, IMemoryRepository implementations, and the memory
       capability's self-test. Depends on CleoCore only. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>False</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CleoCore\CleoCore.csproj" />
  </ItemGroup>

  <!-- Memory module internals stay internal; only the CLI constructs them
       (Program.cs wires up the repository, embedding provider and tools). -->
  <ItemGroup>
    <InternalsVisibleTo Include="CleoAgent" />
  </ItemGroup>

</Project>